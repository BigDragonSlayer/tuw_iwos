<launch>

  <arg name="model" default="$(find-pkg-share tuw_iwos_robot_description)/urdf/iwos.xml"/>
  <arg name="gui" default="true" />
  <arg name="rvizconfig" default="$(find-pkg-share tuw_iwos_robot_description)/rviz/urdf.rviz" />

  <node if="$(var gui)" name="joint_state_publisher" pkg="joint_state_publisher_gui" exec="joint_state_publisher_gui" />
  <node unless="$(var gui)" name="joint_state_publisher" pkg="joint_state_publisher" exec="joint_state_publisher" />
  <node name="robot_state_publisher" pkg="robot_state_publisher" exec="robot_state_publisher">
    <param name="robot_description" value="$(command 'xacro $(var model)')" />
  </node>
  <node name="rviz2" pkg="rviz2" exec="rviz2" args="-d $(var rvizconfig)" /> <!--required="true"-->

</launch>
