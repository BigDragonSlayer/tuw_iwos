<?xml version="1.0"?>
<robot name="IWOS">

  <link name="base_link">
    <!-- empty base link -->
  </link>

  <!-- LEFT -->

  <link name="fork_link_left">
    <visual>
      <geometry>
        <mesh filename="package://tuw_iwos_robot_description/resources/mesh/fork_link.dae"/>
      </geometry>
    </visual>
  </link>
  
  <joint name="steering_left" type="revolute">
    <parent link="base_link"/>
    <child link="fork_link_left"/>
    <axis xyz="0 0 1"/>
    <origin xyz="0.1 0.20 0" rpy="0.0 0.0 0.0"/>
    <limit effort="10.0" lower="-0.4363" upper="0.4363" velocity="1.0"/>
  </joint>

  <link name="wheel_link_left">
    <visual>
      <origin xyz="0.10 0.0 0.04" rpy="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="package://tuw_iwos_robot_description/resources/mesh/wheel_link.dae"/>
      </geometry>
    </visual>
  </link>

  <joint name="revolute_left" type="continuous">
    <parent link="fork_link_left"/>
    <child link="wheel_link_left"/>
    <axis xyz="0 1 0"/>
    <origin xyz="-0.10 0.0 -0.04" rpy="0.0 0.0 0.0"/>
    <!--hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface-->
  </joint>
  
  <!-- RIGHT -->

  <link name="fork_link_right">
    <visual>
      <geometry>
        <mesh filename="package://tuw_iwos_robot_description/resources/mesh/fork_link.dae"/>
      </geometry>
    </visual>
  </link>
  
  <joint name="steering_right" type="revolute">
    <parent link="base_link"/>
    <child link="fork_link_right"/>
    <axis xyz="0 0 1"/>
    <origin xyz="0.1 -0.20 0" rpy="0.0 0.0 0.0"/>
    <limit effort="10" lower="-0.4363" upper="0.4363" velocity="1.0"/>
  </joint>

  <link name="wheel_link_right">
    <visual>
      <origin xyz="0.10 0.0 0.04" rpy="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="package://tuw_iwos_robot_description/resources/mesh/wheel_link.dae"/>
      </geometry>
    </visual>
  </link>

  <joint name="revolute_right" type="continuous">
    <parent link="fork_link_right"/>
    <child link="wheel_link_right"/>
    <axis xyz="0 1 0"/>
    <origin xyz="-0.10 0.0 -0.04" rpy="0.0 0.0 0.0"/>
    <!--hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface-->
  </joint>

  <ros2_control name="IWOS_Steering" type="system">
    <hardware>
      <plugin>dynamixel_hardware_interface/DynamixelHardware</plugin>

      <!-- Port and communication settings -->
      <param name="port_name">/dev/ttyUSB0</param>
      <param name="baud_rate">57600</param>
      <param name="error_timeout_ms">1000</param>

      <!-- Port and Communication Settings -->
      <param name="number_of_joints">2</param>
      <param name="number_of_transmissions">2</param>

      <!-- Torque must be disabled at initialization -->
      <param name="disable_torque_at_init">true</param>

      <!-- Transmission <-> Joint matrices -->
      <param name="transmission_to_joint_matrix">
      1, 0,
      0, 1
      </param>
      <param name="joint_to_transmission_matrix">
      1, 0,
      0, 1
      </param>

      <!-- Some different stuff -->
      <param name="dynamixel_model_folder">/param/dxl_model</param>
      <param name="dynamixel_state_pub_msg_name">dynamixel_hardware_interface/dxl_state</param>
      <param name="get_dynamixel_data_srv_name">dynamixel_hardware_interface/get_dxl_data</param>
      <param name="set_dynamixel_data_srv_name">dynamixel_hardware_interface/set_dxl_data</param>
      <param name="reboot_dxl_srv_name">dynamixel_hardware_interface/reboot_dxl</param>
      <param name="set_dxl_torque_srv_name">dynamixel_hardware_interface/set_dxl_torque</param>
    </hardware>

    <joint name="steering_right">
      <command_interface name="position" />
      <state_interface name="position" />
    </joint>

    <joint name="steering_left">
      <command_interface name="position" />
      <state_interface name="position" />
    </joint>

    <gpio name="dxl1">
      <param name="type">dxl</param>
      <param name="ID">0</param>
      <command_interface name="Goal Position"/>
      <state_interface name="Present Position"/>
      <param name="Return Delay Time">0</param>
    </gpio>

    <gpio name="dxl2">
      <param name="type">dxl</param>
      <param name="ID">1</param>
      <command_interface name="Goal Position"/>
      <state_interface name="Present Position"/>
      <param name="Return Delay Time">0</param>
    </gpio>
  </ros2_control>

  <!--ros2_control name="IWOS_Wheels" type="system">
    <hardware>
      <plugin>tuw_hardware_trinamic_interface/TrinamicInterface</plugin>
    </hardware>

    <joint name="revolute_right">
      <param name="serial_port">/dev/ttyACM0</param>
      <command_interface name="velocity" />
      <state_interface name="velocity" />
    </joint>

    <joint name="revolute_left">
      <param name="serial_port">/dev/ttyACM1</param>
      <command_interface name="velocity" />
      <state_interface name="velocity" />
    </joint>
  </ros2_control-->

</robot>
